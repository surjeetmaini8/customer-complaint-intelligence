# Copy this file to .env and fill in values as needed.
# The application runs fully without any of these set (mock/fallback modes).

# ---- LLM (OpenAI-compatible) ----
# Leave LLM_API_KEY empty to run in deterministic mock/fallback mode.
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1

# ---- App ----
APP_ENV=local
LOG_LEVEL=INFO

# ---- Database ----
DATABASE_URL=sqlite:///storage/application.db

# ---- API ----
API_HOST=0.0.0.0
API_PORT=8000

# Optional API protection. Keep false for local development.
API_REQUIRE_KEY=false
API_KEY=

# Optional: set false for production deployments so raw complaint text is not retained.
RETAIN_ORIGINAL_TEXT=true
